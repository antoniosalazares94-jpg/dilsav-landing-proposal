---
import Eyebrow from './Eyebrow.astro';
import { work } from '../data/site';
---

<section id="work" class="bg-white py-24 lg:py-32">
  <div class="container-page">
    <Eyebrow>{work.eyebrow}</Eyebrow>
    <h2 class="mt-8 max-w-[18ch] font-display text-[clamp(2.25rem,4.4vw,3.5rem)] leading-[1.02] font-medium tracking-[-0.035em]">
      {work.headline}
    </h2>

    <ul class="mt-14 grid gap-6 md:grid-cols-3">
      {
        work.items.map((item) => (
          <li class="group">
            <div class="aspect-[4/3] overflow-hidden rounded-md bg-linear-to-br from-mist to-[#d7dde5]">
              <div class="size-full bg-[radial-gradient(circle_at_70%_30%,rgb(47_111_228/0.18),transparent_60%)] transition-transform duration-700 group-hover:scale-105" />
            </div>
            <p class="mt-6 text-[11px] font-medium tracking-eyebrow text-accent uppercase">{item.tag}</p>
            <h3 class="mt-3 font-display text-2xl tracking-[-0.02em]">{item.title}</h3>
            <p class="mt-2 leading-relaxed text-slate">{item.summary}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
