---
// Small-screen card: the card artwork cropped out of approach.jpg, with its label.
// On large screens the cards are shown inside the full scene instead (see Approach.astro).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  index: number;
  title: string;
  tagline: string;
  image: ImageMetadata;
}

const { index, title, tagline, image } = Astro.props;
---

<article
  data-card={index}
  class="relative aspect-[1/2] w-[56vw] max-w-60 shrink-0 snap-center overflow-hidden rounded-md border border-white/15 shadow-[0_30px_60px_-20px_rgb(0_0_0/0.8)] transition-[border-color,box-shadow] duration-500 data-active:border-accent-glow/60 data-active:shadow-[0_0_0_1px_rgb(106_162_255/0.15),0_30px_80px_-20px_rgb(47_111_228/0.55)]"
>
  <Image src={image} alt="" loading="lazy" class="absolute inset-0 size-full object-cover" />
  <div class="absolute inset-x-0 bottom-0 bg-linear-to-t from-night/90 via-night/60 to-transparent p-4 pt-16">
    <h3 class="text-xs font-semibold tracking-[0.22em] text-white uppercase">{title}</h3>
    <p class="mt-3 max-w-[12ch] text-[10px] leading-[1.7] tracking-[0.28em] text-white/70 uppercase">{tagline}</p>
  </div>
</article>
