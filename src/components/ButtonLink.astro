---
interface Props {
  href: string;
  tone?: 'dark' | 'light';
  class?: string;
}

const { href, tone = 'dark', class: className } = Astro.props;
---

<a
  href={href}
  class:list={[
    'group inline-flex items-center gap-6 rounded-md px-7 py-4 text-[15px] font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent',
    tone === 'dark' ? 'bg-ink text-white hover:bg-accent' : 'bg-white text-ink hover:bg-accent hover:text-white',
    className,
  ]}
>
  <slot />
  <svg
    class="size-5 transition-transform group-hover:translate-x-1"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    aria-hidden="true"
  >
    <path d="M4 12h16m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
</a>
