---
import Eyebrow from './Eyebrow.astro';
import { about } from '../data/site';
---

<section id="about" class="bg-mist py-24 lg:py-32">
  <div class="container-page grid gap-14 lg:grid-cols-2 lg:gap-20">
    <div>
      <Eyebrow>{about.eyebrow}</Eyebrow>
      <h2 class="mt-8 max-w-[16ch] font-display text-[clamp(2.25rem,4.4vw,3.5rem)] leading-[1.02] font-medium tracking-[-0.035em]">
        {about.headline}
      </h2>
      <p class="mt-7 max-w-[48ch] leading-relaxed text-slate">{about.body}</p>
    </div>

    <ol class="divide-y divide-ink/10 border-y border-ink/10">
      {
        about.principles.map((p, i) => (
          <li class="grid grid-cols-[3rem_1fr] gap-4 py-8">
            <span class="text-sm text-slate tabular-nums">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="text-xs font-semibold tracking-eyebrow uppercase">{p.title}</h3>
              <p class="mt-3 leading-relaxed text-slate">{p.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
